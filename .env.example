APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
WHATSAPP_NUMBER=52XXXXXXXXXX
PHONE_NUMBER=+52XXXXXXXXXX

# Ruta absoluta donde viven los archivos subidos por usuarios (imágenes de
# producto, galería, logos, avatares, banners de slider). Debe apuntar FUERA
# del árbol deployado por git (carpeta HERMANA de public_html, no una
# subcarpeta), porque el auto-deploy resetea ese árbol en cada push y
# borraría todo lo no trackeado en git (estas carpetas están en .gitignore
# a propósito). Vacío/omitida en local: cae en public_path() (public/uploads),
# igual que antes. Usar siempre "/" en la ruta, nunca "\".
# Producción (cPanel), ejemplo: /home/macdelno/persistent_uploads
UPLOADS_BASE_PATH=

# Marca de agua aplicada a imágenes de producto (ver config/watermark.php)
WATERMARK_ENABLED=true
WATERMARK_IMAGE=uploads/logo/webp-horizontal.webp
WATERMARK_OPACITY=20
WATERMARK_ROTATION=-30
WATERMARK_TILE_SCALE_PERCENT=22
WATERMARK_SPACING_FACTOR=1.4

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
