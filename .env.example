APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
WHATSAPP_NUMBER=52XXXXXXXXXX
PHONE_NUMBER=+52XXXXXXXXXX

# Ruta absoluta donde viven los archivos subidos por usuarios (imágenes de
# producto, galería, logos, avatares, banners de slider). Debe apuntar FUERA
# del árbol deployado por git (carpeta HERMANA de public_html, no una
# subcarpeta), porque el auto-deploy resetea ese árbol en cada push y
# borraría todo lo no trackeado en git (estas carpetas están en .gitignore
# a propósito). Vacío/omitida en local: cae en public_path() (public/uploads),
# igual que antes. Usar siempre "/" en la ruta, nunca "\".
# Producción (cPanel), ejemplo: /home/macdelno/persistent_uploads
UPLOADS_BASE_PATH=

# Marca de agua aplicada a imágenes de producto (ver config/watermark.php)
WATERMARK_ENABLED=true
WATERMARK_IMAGE=uploads/logo/webp-horizontal.webp
WATERMARK_OPACITY=20
WATERMARK_ROTATION=-30
WATERMARK_TILE_SCALE_PERCENT=22
WATERMARK_SPACING_FACTOR=1.4

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Buzón que recibe el aviso de cada pedido pagado (ver config/mail.php)
MAIL_ADMIN_ORDER_ADDRESS=administracion@macdelnorte.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Atribucion por folio (ver config/attribution.php). Dejar comentado hasta necesitarlo.
# Token Bearer del endpoint GET /api/attribution/lookup (n8n). Vacio o de menos de 32 caracteres = endpoint cerrado (503).
# ATTRIBUTION_API_TOKEN=
# Interruptor maestro del folio en el navegador (false = no cambia ningun enlace).
# ATTRIBUTION_FOLIO_ENABLED=false
# Ubicaciones con folio: * (todas) o lista separada por comas, p. ej. flotante,footer_oficina
# ATTRIBUTION_FOLIO_PLACEMENTS=*
# Folio invisible en el mensaje de WhatsApp (activar solo con el aviso de privacidad publicado).
# ATTRIBUTION_INVISIBLE_FOLIO=false
# Verificacion de Origin/Referer en POST /track-conversion (true = solo eventos del propio sitio; 204 si no).
# ATTRIBUTION_ORIGIN_CHECK=true
# Hosts extra permitidos ademas de APP_URL (con/sin www), separados por comas, comparacion exacta.
# ATTRIBUTION_ALLOWED_HOSTS=
# Numero de WhatsApp (solo digitos, con lada de pais) que abren los botones en modo prueba del Laboratorio de atribucion.
# Respaldo: el numero guardado desde el panel (Laboratorio de atribucion > Ajustes de prueba) tiene prioridad sobre este.
# ATTRIBUTION_TEST_WHATSAPP_NUMBER=
# Solo para desarrollo local: permite que el boton "Enviar mensaje de prueba a n8n" apunte a hosts privados (localhost, 192.168.x). Se ignora en produccion.
# ATTRIBUTION_LAB_ALLOW_PRIVATE_N8N=false
